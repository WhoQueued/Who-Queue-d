# Copy this file to .env.local and fill in real values.
# Get SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET from:
# https://developer.spotify.com/dashboard -> your app -> Settings

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# For local dev, this must exactly match a Redirect URI registered in the
# Spotify dashboard. For production, use your real https Vercel domain,
# e.g. https://who-queued.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
