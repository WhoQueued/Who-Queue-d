# Copy this file to .env.local and fill in real values.

# --- Spotify ---
# Get these from https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# For local dev, this must exactly match a Redirect URI registered in the
# Spotify dashboard. For production, use your real https Vercel domain,
# e.g. https://who-queued.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# --- Supabase ---
# Get these from your Supabase project -> Settings -> API
# NEXT_PUBLIC_* values are safe to expose to the browser -- the anon key
# can only do what supabase/schema.sql's RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# SUPABASE_SERVICE_ROLE_KEY is SECRET -- it bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_, never put it in client-side code.
# Used only inside pages/api/** routes.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
